# Codex ImageGen Proxy Configuration
# Copy this to .env and customize

# API key for client authentication (auto-generated on first run if empty)
PROXY_API_KEY=

# Optional key for /admin/* API endpoints. Leave empty to disable /admin/*.
ADMIN_API_KEY=

# Server port
PORT=3456

# Path to Codex auth.json (default: ~/.codex/auth.json)
CODEX_AUTH_PATH=

# Docker-friendly persistent state
POOL_ROOT=
ACCOUNTS_DIR=
EVENTS_LOG=
COOLDOWN_DEFAULT_MS=60000

# Codex API base URL
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex

# OAuth refresh endpoint
CODEX_REFRESH_URL=https://auth.openai.com/oauth/token

# Default model for image generation
DEFAULT_MODEL=gpt-5.4

# Default timeout in milliseconds (15 minutes)
DEFAULT_TIMEOUT_MS=900000

# Browser management UI at /management. Required to enable the UI.
MANAGEMENT_PASSWORD=
MANAGEMENT_SESSION_SECRET=
MANAGEMENT_SESSION_TTL_MS=43200000
MANAGEMENT_COOKIE_SECURE=false

# Manual OAuth login helper used by /management.
OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OAUTH_SESSION_TTL_MS=600000
