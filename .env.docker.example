# Copy to .env.docker before running docker compose.

PROXY_API_KEY=sk-proxy-change-me
MANAGEMENT_PASSWORD=change-me-management-password
MANAGEMENT_SESSION_SECRET=change-me-long-random-session-secret

PORT=3456
CODEX_AUTH_PATH=/data/auth.json
POOL_ROOT=/data/pool
ACCOUNTS_DIR=/data/pool/accounts
EVENTS_LOG=/data/pool/events.log
OUTPUT_DIR=/data/output

CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_REFRESH_URL=https://auth.openai.com/oauth/token
DEFAULT_MODEL=gpt-5.4
DEFAULT_TIMEOUT_MS=900000
COOLDOWN_DEFAULT_MS=60000
MANAGEMENT_SESSION_TTL_MS=43200000
OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OAUTH_SESSION_TTL_MS=600000
